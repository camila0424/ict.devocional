# Base de datos PostgreSQL (Neon)
# DATABASE_URL: conexión con pooling · DIRECT_URL: conexión directa (migraciones)
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/ict_devocional?sslmode=require"
DIRECT_URL="postgresql://user:password@host.neon.tech/ict_devocional?sslmode=require"

# Auth.js — generar con: npx auth secret
AUTH_SECRET=""
AUTH_URL="https://ict-devocional.vercel.app"

# Web Push — generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:soporte@soyict.org"

# App
NEXT_PUBLIC_APP_URL="https://ict-devocional.vercel.app"

# Admin API — protege /api/admin/* con este secreto
ADMIN_SECRET=""

# Groq — para el parser del plan devocional (ict-plan-parser.html)
# Obtener en: console.groq.com/keys (tier gratuito, sin tarjeta)
GROQ_API_KEY=""
